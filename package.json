{
  "name": "nhsuk-prototype-kit",
  "version": "5.0.0",
  "description": "Rapidly create HTML prototypes of NHS websites and services.",
  "main": "app.js",
  "scripts": {
    "start": "node .",
    "generate": "node scripts/generate-data.js",
    "heroku-postbuild": "npm run generate",
    "build:static-error-page": "node scripts/build-static-error-page.js",
    "docs": "node scripts/generate-utils-reference.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:journeys": "playwright test",
    "test:routes": "node scripts/route-sweep.js",
    "test": "npm run lint && npm run test:routes && npm run test:journeys"
  },
  "author": "https://github.com/nhsuk/",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "accessible-autocomplete": "^3.0.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.22",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.0",
    "nhsuk-frontend": "^10.4.2",
    "nhsuk-prototype-kit": "^8.3.0",
    "pluralize": "^8.0.0",
    "weighted": "^1.0.0"
  },
  "engines": {
    "node": "^22.16.0 || ^24.11.0",
    "npm": "^11.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "cssnano": "^8.0.6",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "purgecss": "^8.0.0"
  }
}
