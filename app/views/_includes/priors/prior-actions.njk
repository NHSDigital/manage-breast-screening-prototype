{# app/views/_includes/priors/prior-actions.njk

   The status-update actions available for one prior mammogram, as inline
   forms. Which actions show depends on the current request status. Shared by
   the priors dashboard cells and the case's disclosed mammogram cards.

   Expects: mammogram, thisAppointment. Optional: priorsReturnTo - where the
   no-JS form submit returns to (defaults to the priors dashboard). #}

{% if mammogram.requestStatus == "not_requested" or mammogram.requestStatus == "pending" %}
  {% set priorActions = ["requested", "not_available", "not_needed"] %}
{% elseif mammogram.requestStatus == "requested" %}
  {% set priorActions = ["received", "not_available", "not_needed"] %}
{% else %}
  {% set priorActions = [] %}
{% endif %}

{% set priorActionLabels = {
  requested: "Mark as requested",
  received: "Mark as received",
  not_available: "Not available",
  not_needed: "Not needed"
} %}

{% for action in priorActions %}
  <form action="/reading/priors/update-status" method="POST" class="js-prior-status-form">
    <input type="hidden" name="appointmentId" value="{{ thisAppointment.id }}">
    <input type="hidden" name="mammogramId" value="{{ mammogram.id }}">
    <input type="hidden" name="newStatus" value="{{ action }}">
    {% if priorsReturnTo %}
      <input type="hidden" name="returnTo" value="{{ priorsReturnTo }}">
    {% endif %}
    <button type="submit" class="nhsuk-link--no-visited-state app-link-button">{{ priorActionLabels[action] }}</button>
  </form>
{% endfor %}
