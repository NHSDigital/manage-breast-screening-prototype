{# app/views/_includes/live-updates.njk #}
{#
  Live updates when this browser shares data with others (see
  app/lib/shared-data.js and live-updates.js). Nothing renders when it isn't.

  The template holds the banner shown when the page changes and has no live
  region to refresh. Its data-live-ids are the records this page shows, from
  the locals the dynamic routes set, so changes to other records are ignored.
#}

{% if sharedData.isShared %}
  {% set livePageIds = [] %}
  {% for record in [clinic, appointment, participant, episode] %}
    {% if record.id %}
      {% set livePageIds = livePageIds | push(record.id) %}
    {% endif %}
  {% endfor %}

  <template data-live-updates-banner data-live-ids="{{ livePageIds | join(' ') }}">
    {% set bannerHtml %}
      <p class="nhsuk-u-margin-bottom-0">This page has been updated. <a href="" class="nhsuk-notification-banner__link">Refresh the page</a></p>
    {% endset %}
    {{ notificationBanner({
      html: bannerHtml,
      role: "status",
      attributes: {
        "data-live-updates-shown": ""
      }
    }) }}
  </template>
  <script type="module" src="/assets/javascript/live-updates.js"></script>
{% endif %}
