{# app/views/_includes/mastectomy-imaging-warning.njk #}

{# Tells readers when the images aren't a standard set, and why. A mastectomy
   that still had both breasts imaged keeps its own callout #}
{% set expectedViews = appointment | getExpectedViews %}
{% set mastectomyNotes = appointment.medicalInformation.medicalHistory | getMastectomyImagingNotes %}

{% if not expectedViews.isStandardSet %}
  {% call warningCallout({
    heading: expectedViews.summary,
    headingLevel: 2
  }) %}
    <p>{{ expectedViews.reasonText }}.</p>
    {% for note in mastectomyNotes %}
      {% if note.details %}
        <p>Details: {{ note.details }}</p>
      {% endif %}
    {% endfor %}
  {% endcall %}
{% else %}
  {% for note in mastectomyNotes %}
    {% call warningCallout({
      heading: note.heading,
      headingLevel: 2
    }) %}
      <p>{{ note.imagedText }}</p>
      {% if note.details %}
        <p>Details: {{ note.details }}</p>
      {% endif %}
    {% endcall %}
  {% endfor %}
{% endif %}
