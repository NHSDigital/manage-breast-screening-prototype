{# app/views/_includes/summary-lists/medical-information/other-relevant-information #}
{# Shows only the other medical information (free-text) row.
   Breast density factors have their own include: breast-density-factors.njk #}

{{ summaryList({
  rows: [
    {
      key: {
        text: "Other medical information"
      },
      value: {
        html: appointment.medicalInformation.otherMedicalInformation
      },
      actions: {
        items: [
          {
            href: contextUrl + "/medical-information/other-medical-information" | urlWithReferrer(referrerChain | appendReferrer(currentUrl), scrollTo),
            text: "Change",
            visuallyHiddenText: "other medical information"
          }
        ]
      } if allowEdits
    }
  ],
  lastRowBorder: false
} | openInModal | handleSummaryListMissingInformation ) }}
