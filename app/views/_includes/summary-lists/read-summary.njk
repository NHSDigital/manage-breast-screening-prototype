{# app/views/_includes/summary-lists/read-summary.njk #}
{# 
  Summary list showing a reading assessment.
  Outputs a summary list - wrap in a card if needed.
  
  Parameters:
    - read: object - the read data (defaults to data.imageReadingTemp)
    - allowEdits: boolean - whether to show change links (default: false)
    - changeOpinionUrl: string - URL for change opinion link
    - hideEmptyRows: boolean - if true, only show rows that have data (default: false)
    - showAnnotationImages: boolean - if true, show thumbnail images with markers (default: false)
    - annotationImagePaths: object - image paths for thumbnails (required if showAnnotationImages)
    - annotationViewOrder: string - view order for thumbnails (default: "cc-first")
    - showReaderRow: boolean - add a "Read by" row with reader and date, for
      contexts with no card heading or label carrying that (default: false)
    - isOutcome: boolean - the read settles the case rather than offering one
      of several opinions, so its rows are labelled as an outcome (default:
      true for arbitration reads). Callers rendering an in-progress
      arbitration decision, which has no readType yet, set this themselves
    - opinionLabel: string - override the opinion row's label (default:
      "Outcome" when isOutcome, otherwise "Opinion")
    - hideFinalisedRow: boolean - if true, never show the finalised row - for
      contexts where when a read finalised isn't the point (default: false)
    - annotationRowHtml: string - supplied content for the annotations row,
      shown whatever the read's own opinion - lets a caller pool annotations
      from several reads (default: built from this read's own annotations)
    - extraRows: array - summary list rows to add before the finalised row
    - awaitingFinalisation: boolean - treat the read as awaiting finalisation
      whatever its own state, marking the opinion and hiding the finalised
      row - for case-level summaries where the case has not yet concluded
      even though this read may have (default: false)

  Callers set these with set before including; a caller reusing this include
  after another has set isOutcome, opinionLabel, hideFinalisedRow,
  annotationRowHtml or extraRows should reset them.
#}

{% from '_components/annotation-list/macro.njk' import appAnnotationList %}
{% from '_components/annotation-images/macro.njk' import appAnnotationImages %}

{% set read = read if read is defined else data.imageReadingTemp %}
{% set allowEdits = allowEdits if allowEdits is defined else false %}
{% set hideEmptyRows = hideEmptyRows if hideEmptyRows is defined else false %}
{% set hideOpinionRow = hideOpinionRow if hideOpinionRow is defined else false %}
{% set hideFinalisedRow = hideFinalisedRow if hideFinalisedRow is defined else false %}
{# Support legacy opinionOnly parameter #}
{% if opinionOnly is defined and opinionOnly %}
  {% set hideEmptyRows = true %}
{% endif %}

{# Count annotations #}
{% set leftAnnotations = read.left.annotations if read.left and read.left.annotations else [] %}
{% set rightAnnotations = read.right.annotations if read.right and read.right.annotations else [] %}
{% set totalAnnotations = leftAnnotations | length + rightAnnotations | length %}

{% set showAnnotationImages = showAnnotationImages if showAnnotationImages is defined else false %}
{% set annotationViewOrder = annotationViewOrder if annotationViewOrder is defined else (data.settings.mammogramViewOrder or "cc-first") %}

{# Build annotation summary using components #}
{% set annotationSummaryHtml %}
  {% if totalAnnotations == 0 %}
    No annotations added
  {% else %}
    {% for breastSide in ["right", "left"] %}
      {% set sideAnnotations = rightAnnotations if breastSide == "right" else leftAnnotations %}
      {% if sideAnnotations | length > 0 %}
        <p class="nhsuk-u-font-weight-bold nhsuk-u-margin-bottom-2">{{ breastSide | capitalize }} breast</p>

        {% if showAnnotationImages and annotationImagePaths %}
          <div class="nhsuk-u-margin-bottom-3">
            {{ appAnnotationImages({
              side: breastSide,
              imagePaths: annotationImagePaths,
              viewOrder: annotationViewOrder,
              annotations: sideAnnotations,
              mode: "readonly",
              size: "thumbnail",
              showLabels: true
            }) }}
          </div>
        {% endif %}

        {{ appAnnotationList({
          annotations: sideAnnotations,
          editable: false
        }) }}

        {# Separator between breast groups when both sides have annotations #}
        {% if breastSide == "right" and leftAnnotations | length > 0 %}
          <hr class="nhsuk-u-margin-top-4 nhsuk-u-margin-bottom-4">
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endset %}

{# Build rows based on result type #}
{% set rows = [] %}

{% set readerRowHtml = (read.readerId | getUsername({ format: "short" })) + ", " + (read.timestamp | formatDate) %}

{# An arbitration read settles the case, so it is the outcome rather than one
   of several opinions - and its rows say so #}
{% set isOutcome = isOutcome if isOutcome is defined else (read.readType == 'arbitration') %}
{% set opinionLabel = opinionLabel if opinionLabel else ("Outcome" if isOutcome else "Opinion") %}
{% if not hideOpinionRow %}
  {% set opinionValueHtml %}
    {% set readOpinionRead = read %}
    {% set readOpinionContext = 'own' %}
    {% set readOpinionShowFinalisation = 'unfinalised' if read.timestamp or awaitingFinalisation %}
    {% set readOpinionForceUnfinalised = awaitingFinalisation %}
    {% include "_includes/reading/read-opinion-tag.njk" %}
  {% endset %}
  {% set rows = rows | push({
    key: {
      text: opinionLabel
    },
    value: {
      html: opinionValueHtml
    },
    actions: {
      items: [
        {
          href: changeOpinionUrl,
          text: "Change",
          visuallyHiddenText: opinionLabel | lower
        }
      ]
    } if allowEdits and changeOpinionUrl
  }) %}
{% endif %}

{# Determine if detail rows have data #}
{% set hasNormalDetails = read.opinion == 'normal' and read.normalDetails %}
{% set hasTechRecallViews = read.opinion == 'technical_recall' and read.technicalRecall and read.technicalRecall.views and (read.technicalRecall.views | length > 0) %}
{% set hasBreastAssessment = read.opinion == 'recall_for_assessment' and ((read.left and read.left.breastAssessment) or (read.right and read.right.breastAssessment)) %}
{% set hasAnnotations = read.opinion == 'recall_for_assessment' and (totalAnnotations > 0) %}

{# Normal - additional details #}
{% if read.opinion == 'normal' and (not hideEmptyRows or hasNormalDetails) %}
  {% set rows = rows | push({
    key: {
      text: "Details"
    },
    value: {
      text: read.normalDetails
    },
    actions: {
      items: [
        {
          href: "./normal-details" | urlWithReferrer(currentUrl),
          text: "Change",
          visuallyHiddenText: "details"
        } | openInModal
      ]
    } if allowEdits
  }) %}
{% endif %}

{# Technical recall - views to retake #}
{% if read.opinion == 'technical_recall' %}
  {% set techRecallViews = read.technicalRecall.views | default({}) %}
  
  {% if techRecallViews | length > 0 %}
    {# Build display text for each view with reason #}
    {% set viewsHtml %}
      <ul class="nhsuk-list">
        {% for viewCode, viewData in techRecallViews %}
          {# Only show views that have a reason — unselected views are stored with an empty reason #}
          {% if viewData.reason %}
            <li>
              <strong>{{ viewCode }}</strong>: {{ viewData.reason }}
              {%- if viewData.additionalDetails %} – {{ viewData.additionalDetails }}{% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endset %}

    {% set rows = rows | push({
      key: {
        text: "Views to retake"
      },
      value: {
        html: viewsHtml
      },
      actions: {
        items: [
          {
            href: "./technical-recall" | urlWithReferrer(currentUrl),
            text: "Change",
            visuallyHiddenText: "views"
          } | openInModal
        ]
      } if allowEdits
    }) %}
  {% endif %}
{% endif %}

{# Recall for assessment details #}
{% if read.opinion == 'recall_for_assessment' %}
  
  {% set breastAssessmentHtml %}
    <div class="nhsuk-grid-row nhsuk-u-margin-bottom-0">
      {% for breastSide in ["right", "left"] %}
        {% set breastData = read[breastSide] %}
        {% set sideLabel = breastSide | capitalize %}
        <div class="nhsuk-grid-column-one-half nhsuk-u-margin-bottom-2">
          <p class="nhsuk-u-font-weight-bold nhsuk-u-margin-bottom-1">{{ sideLabel }} breast</p>
          {% if breastData and breastData.breastAssessment %}
            {% set assessmentKey = breastData.breastAssessment | lower %}
            {% set tagStatusMap = {
              "normal": "normal",
              "clinical": "clinical_recall",
              "abnormal": "abnormal"
            } %}
            {% set tagStatus = tagStatusMap[assessmentKey] | default(breastData.breastAssessment) %}
            <div class="nhsuk-u-margin-bottom-1">
              {{ tagStatus | toTag }}
            </div>
            {% if breastData.comment %}
              <p class="nhsuk-u-margin-bottom-0">Comment: {{ breastData.comment }}</p>
            {% endif %}
          {% else %}
            <p class="nhsuk-u-secondary-text-color nhsuk-u-margin-bottom-0">Not recorded</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endset %}

  {# Only show the detail row if we have data, or if not hiding empty rows #}
  {% set breastAssessmentLabel = "Outcome details" if isOutcome else "Detailed opinion" %}
  {% if not hideEmptyRows or hasBreastAssessment %}
    {% set rows = rows | push({
      key: {
        text: breastAssessmentLabel
      },
      value: {
        html: breastAssessmentHtml
      },
      actions: {
        items: [
          {
            href: "./recall-for-assessment-details" | urlWithReferrer(currentUrl),
            text: "Change",
            visuallyHiddenText: breastAssessmentLabel | lower
          }
        ]
      } if allowEdits
    }) %}
  {% endif %}

  {# Only show annotations if we have data, or if not hiding empty rows #}
  {% if annotationRowHtml or not hideEmptyRows or hasAnnotations %}
    {% set rows = rows | push({
      key: {
        text: "Annotations"
      },
      value: {
        html: annotationRowHtml or annotationSummaryHtml
      },
      actions: {
        items: [
          {
            href: "./recall-for-assessment-details" | urlWithReferrer(currentUrl),
            text: "Change",
            visuallyHiddenText: "annotations"
          }
        ]
      } if allowEdits
    }) %}
  {% endif %}

{% endif %}

{# Supplied annotations (eg pooled from every read) still get their row when
   the read's own opinion would not show one #}
{% if annotationRowHtml and read.opinion != 'recall_for_assessment' %}
  {% set rows = rows | push({
    key: {
      text: "Annotations"
    },
    value: {
      html: annotationRowHtml
    }
  }) %}
{% endif %}

{# Normal with details #}
{% if read.opinion == 'normal' %}
  {% if read.normalComment %}
    {% set rows = rows | push({
      key: {
        text: "Comment"
      },
      value: {
        text: read.normalComment
      }
    }) %}
  {% endif %}
{% endif %}

{# Who read it and when, for contexts with no card heading or label carrying
   that already #}
{% if showReaderRow and read.readerId %}
  {% set rows = rows | push({
    key: {
      text: readerRowLabel or "Read by"
    },
    value: {
      text: readerRowHtml
    }
  }) %}
{% endif %}

{# A panel arbitration was decided by several people together, so the read's
   own reader byline doesn't tell the whole story #}
{% if read.arbitratorIds | length %}
  {% set arbitratorsHtml %}
    {%- for arbitratorId in read.arbitratorIds %}
      {{ arbitratorId | getUsername({ format: "short", identifyCurrentUser: true }) }}{{ "," if not loop.last }}
    {%- endfor %}
  {% endset %}
  {% set rows = rows | push({
    key: {
      text: "Arbitrated by"
    },
    value: {
      html: arbitratorsHtml
    }
  }) %}
{% endif %}

{# Rows the caller wants beyond the read's own - eg who the original readers
   were, when this summary reports a case's outcome #}
{% for extraRow in extraRows or [] %}
  {% set rows = rows | push(extraRow) %}
{% endfor %}

{# When it was finalised. Reads finalised by the delay passing have no
   finalisedAt stamp, so fall back to the moment the delay ran out. #}
{% if not hideFinalisedRow and not awaitingFinalisation and read.timestamp and (read | isReadFinalised(data.settings)) %}
  {% set finalisedAt = read.finalisedAt or (read | getAutoFinaliseTime(data.settings)) %}
  {% if finalisedAt %}
    {% set rows = rows | push({
      key: {
        text: "Finalised"
      },
      value: {
        text: finalisedAt | formatDateTime
      }
    }) %}
  {% endif %}
{% endif %}

{{ summaryList({
  rows: rows | removeLastRowBorder
} | handleSummaryListMissingInformation) }}
