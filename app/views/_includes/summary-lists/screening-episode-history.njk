{# app/views/_includes/summary-lists/screening-episode-history.njk #}

{# A participant's screening rounds, newest first. Past rounds are held as
   summary-only episodes, so this covers their whole history without needing
   the old appointments to exist. An open episode is not history - the
   participant page promotes it separately, so it is excluded here. #}

{% if episodeHistory.length %}

  {% set tableRows = [] %}
  {% for row in episodeHistory %}
    {% set episode = row.episode %}

    {% set outcomeHtml %}
      {% if episode.outcome %}
        {{ tag({
          text: episode.outcome | getEpisodeOutcomeText,
          colour: episode.outcome | getEpisodeOutcomeTagColour
        }) }}
      {% else %}
        <span class="nhsuk-u-secondary-text-colour">Not yet</span>
      {% endif %}
    {% endset %}

    {% set episodeLinkHtml %}
      <a href="/participants/{{ episode.participantId }}/episodes/{{ episode.id }}">
        View episode
      </a>
    {% endset %}

    {% set tableRows = tableRows | push([
      {
        html: (row.screenedDate | formatDate) if row.screenedDate else ("Not screened" | asHint)
      },
      {
        html: (row.closedDate | formatDate) if row.closedDate else ("—" | asHint)
      },
      {
        text: episode.type | sentenceCase
      },
      {
        html: outcomeHtml
      },
      {
        html: episodeLinkHtml
      }
    ]) %}
  {% endfor %}

  {{ table({
    compact: true,
    striped: true,
    head: [
      {
        text: "Screened"
      },
      {
        text: "Closed"
      },
      {
        text: "Type"
      },
      {
        text: "Outcome"
      },
      {
        text: "Episode"
      }
    ],
    rows: tableRows
  }) }}

{% else %}
  <p>No previous screening episodes</p>
{% endif %}
