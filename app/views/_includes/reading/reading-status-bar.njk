{# app/views/_includes/reading/reading-status-bar.njk #}
{# Status bar for reading workflow - shows session/clinic context and participant info #}

{% set isClinicContext = session.clinicId %}
{% set isSessionContext = not isClinicContext %}

{% set firstRowItems = [] %}

{# Environment tag - always first item #}
{% if isArbitration %}
  {% set firstRowItems = firstRowItems | push({
    html: "Arbitration" | toTag({ colour: "purple" })
  }) %}
{% else %}
  {% set firstRowItems = firstRowItems | push({
    html: "Reading" | toTag({ colour: "aqua-green" })
  }) %}
{% endif %}

{# Clinic context item (session context has no label, just the environment tag) #}
{% if isClinicContext %}
  {% set locationName %}
    {% if location.type === 'mobile_unit' %}
      {{ location.name }} at {{ clinic.siteName }}
    {% else %}
      {{ location.name }}
    {% endif %}
  {% endset %}
  {% set firstRowItems = firstRowItems | push({
    key: "Clinic:",
    value: (locationName + " - " + (clinic.date | formatDate | noWrap))
  }) %}
{% endif %}

{# Progress text. doneCount counts arbitrated cases in an arbitration session
   and the user's own reads otherwise #}
{% set progressText %}
  {{ progress.doneCount }} {{ "arbitrated" if isArbitration else "read" }}
  {%- if progress.sessionAwaitingPriorsCount > 0 -%}
    , {{ progress.sessionAwaitingPriorsCount }} awaiting priors
  {%- endif -%}
  {%- if progress.deferredCount > 0 -%}
    , {{ progress.deferredCount }} deferred
  {%- endif -%}
  , {{ progress.targetRemaining }} remaining
  {%- if progress.skippedAppointments | length > 0 %}
     ({{ progress.skippedAppointments | length }} skipped)
  {%- endif %}
{% endset %}

{# Screened date and progress on same row as environment tag #}
{% if appointment %}
  {% set firstRowItems = firstRowItems | push({
    key: "Screened:",
    value: appointment.timing.startTime | formatDate
  }) %}
{% endif %}

{% set firstRowItems = firstRowItems | push({
  key: "Progress:",
  value: progressText | trim
}) %}

{# Build rows array #}
{% set statusBarRows = [
  { items: firstRowItems }
] %}

{# Add participant row if participant exists #}
{% if participant %}
  {% set participantRowItems = [] %}

  {# Full name #}
  {% set nameWithAge %}
    {{ participant | getFullNameReversed }}
  {% endset %}
  {% set participantRowItems = participantRowItems | push({
    html: "<strong>" + nameWithAge + "</strong>"
  }) %}

  {% set dobValue %}
    {{ participant.demographicInformation.dateOfBirth | formatDate }} {% if participant | getAge %}
      ({{ participant | getAge }} years)
    {% endif %}
  {% endset %}

  {# DOB #}
  {% set participantRowItems = participantRowItems | push({
    key: "DOB:",
    value: dobValue
  }) %}

  {# NHS Number #}
  {% set participantRowItems = participantRowItems | push({
    key: "NHS:",
    value: participant.medicalInformation.nhsNumber | formatNhsNumber
  }) %}

  {# SX Number #}
  {% set participantRowItems = participantRowItems | push({
    key: "SX:",
    value: participant.sxNumber
  }) %}



  {% set statusBarRows = statusBarRows | push({
    items: participantRowItems
  }) %}
{% endif %}

{{ appStatusBar({
  rows: statusBarRows
}) }}
