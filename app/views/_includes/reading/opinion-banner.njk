{# app/views/_includes/reading/opinion-banner.njk #}
{# Temporary banner shown after recording the previous opinion. linkText
   replaces the default "Review" where the link goes somewhere else #}

{% set readingOpinionBanner = flash.readingOpinionBanner[0] if flash.readingOpinionBanner %}
{% if readingOpinionBanner %}
  <div class="app-reading-opinion-banner" data-reading-opinion-banner="true" data-auto-close-delay="{{ data.config.reading.opinionBannerDurationMs }}">
    <p class="app-reading-opinion-banner__text">{{ readingOpinionBanner.text }}</p>
    <a class="app-reading-opinion-banner__link" href="{{ readingOpinionBanner.editHref }}">
      {%- if readingOpinionBanner.linkText -%}
        {{ readingOpinionBanner.linkText }}<span class="nhsuk-u-visually-hidden"> for {{ readingOpinionBanner.participantName }}</span>
      {%- else -%}
        Review<span class="nhsuk-u-visually-hidden"> opinion for {{ readingOpinionBanner.participantName }}</span>
      {%- endif -%}
    </a>
  </div>
{% endif %}