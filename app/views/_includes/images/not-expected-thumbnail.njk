{# app/views/_includes/images/not-expected-thumbnail.njk #}
{#
  Placeholder for a mammogram view that wasn't expected, for example after a
  mastectomy. Goes inside an app-mammogram-thumbnail__image-wrapper, in place
  of the "No image" placeholder.

  Set before including:
  - notExpectedReason: short reason, such as "Mastectomy" (optional)
#}

<div class="app-mammogram-thumbnail__missing app-mammogram-thumbnail__missing--not-expected" data-not-expected>
  <span class="app-mammogram-thumbnail__missing-text">Not expected</span>
  {% if notExpectedReason %}
    <span class="app-mammogram-thumbnail__missing-reason">{{ notExpectedReason }}</span>
  {% endif %}
</div>
