{# app/views/_includes/images/pacs-viewer-meta.njk

   Tells the PACS viewer window (reading/mammogram-viewer.html) which study
   this page is showing: meta tags it reads when it opens and asks for the
   current study, plus an immediate broadcast so an open viewer follows the
   page. Include in the head, having set:
   - viewerAppointment - the appointment whose images to show
   - viewerParticipant - whose they are
   - viewerAutoOpen - whether to open the viewer if it is not already open #}

{% set mammogramImages = getImagesForAppointment(viewerAppointment.id, "diagrams", { appointment: viewerAppointment }) %}
<meta name="mammogram-appointment-id" content="{{ viewerAppointment.id }}">
<meta name="mammogram-participant-name" content="{{ viewerParticipant | getFullNameReversed }}">
<meta name="mammogram-nhs-number" content="{{ viewerParticipant.medicalInformation.nhsNumber | formatNhsNumber }}">
<meta name="mammogram-sx-number" content="{{ viewerParticipant.sxNumber }}">
<meta name="mammogram-date-of-birth" content="{{ viewerParticipant.demographicInformation.dateOfBirth | formatDate }} ({{ viewerParticipant | getAge }} years)">
<meta name="mammogram-auto-open" content="{{ 'true' if viewerAutoOpen else 'false' }}">
{% if mammogramImages and mammogramImages.paths %}
  {# Pass image paths - util filters to only include views present in mammogram data #}
  <meta name="mammogram-image-rcc" content="{{ mammogramImages.paths.rcc or '' }}">
  <meta name="mammogram-image-lcc" content="{{ mammogramImages.paths.lcc or '' }}">
  <meta name="mammogram-image-rmlo" content="{{ mammogramImages.paths.rmlo or '' }}">
  <meta name="mammogram-image-lmlo" content="{{ mammogramImages.paths.lmlo or '' }}">
  {# Pass all image paths for additional images view #}
  <meta name="mammogram-all-paths" content="{{ mammogramImages.allPaths | dump | escape }}">
  <meta name="mammogram-has-additional" content="{{ 'true' if mammogramImages.hasAdditionalImages else 'false' }}">
  {# Pass set info for debugging #}
  <meta name="mammogram-set-id" content="{{ mammogramImages.set.id }}">
  <meta name="mammogram-set-description" content="{{ mammogramImages.set.description }}">
  <meta name="mammogram-set-tag" content="{{ mammogramImages.set.tag }}">
  {# Pass context info for debugging #}
  {% set appointmentContext = extractAppointmentContext(viewerAppointment) %}
  <meta name="mammogram-context" content="{{ appointmentContext | dump | escape }}">
{% endif %}

{# Broadcast to an open PACS viewer straight away, before the page finishes loading #}
<script src="/assets/javascript/pacs-viewer-broadcast.js"></script>
