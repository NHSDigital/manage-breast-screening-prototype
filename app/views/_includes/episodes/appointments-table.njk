{# app/views/_includes/episodes/appointments-table.njk

   One row per appointment in the episode. Shared by live and past rounds - a
   past round holds stand-ins rather than appointment records, but an episode
   can hold more than one appointment either way, so the shape is the same.

   Expects `appointmentRows`: { date, type, status, href } per appointment,
   where href is absent for a round with nothing to open. #}

{# A past round alludes to the page an appointment would have, but nothing
   serves it yet - so its link deliberately goes nowhere #}
{% set tableRows = [] %}
{% for appointmentRow in appointmentRows %}
  {% set tableRows = tableRows | push([
    { text: appointmentRow.date | formatDate },
    { text: appointmentRow.type | formatWords | sentenceCase },
    { html: tag({
      text: appointmentRow.status | getStatusText('appointment'),
      colour: appointmentRow.status | getStatusTagColour('appointment')
    }) },
    { html: '<a href="' + (appointmentRow.href or '#') + '">View appointment</a>' }
  ]) %}
{% endfor %}

{{ table({
  head: [
    { text: "Date" },
    { text: "Type" },
    { text: "Status" },
    { html: '<span class="nhsuk-u-visually-hidden">Actions</span>' }
  ],
  rows: tableRows,
  lastRowBorder: false,
  classes: "nhsuk-u-margin-bottom-0"
}) }}
