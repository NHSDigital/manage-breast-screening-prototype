{% from "_includes/reading/case-outcome-tag.njk" import caseOutcomeTag with context %}
{# app/views/_includes/episodes/reading-cases-table.njk

   One row per reading case - one set of images read. Shared by past and live
   rounds, because a case is the same thing either way; only the fidelity of
   what sits behind it differs.

   The individual reads deliberately aren't here. They belong on the case view,
   which is where a reader goes to see who said what. #}

<table class="nhsuk-table app-table--flush">
  <thead class="nhsuk-table__head">
    <tr>
      <th scope="col">Outcome date</th>
      <th scope="col">Reads</th>
      <th scope="col">Outcome</th>
      <th scope="col">Case</th>
    </tr>
  </thead>
  <tbody class="nhsuk-table__body">
    {% for readingCase in episode.readingCases %}
      <tr class="nhsuk-table__row">
        <td class="nhsuk-table__cell">
          {% set outcomeDate = readingCase | getReadingCaseOutcomeDate(data.settings) %}
          {{ outcomeDate | formatDate if outcomeDate else "Not yet concluded" }}
        </td>
        <td class="nhsuk-table__cell">
          {{ (readingCase | getReadsAsArray) | length }}
        </td>
        <td class="nhsuk-table__cell">
          {{ caseOutcomeTag(readingCase) }}
        </td>
        <td class="nhsuk-table__cell">
          <a href="{{ getReadingCaseUrl(readingCase) }}">View case</a>
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
