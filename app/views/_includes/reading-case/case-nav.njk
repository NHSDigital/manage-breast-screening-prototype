{# app/views/_includes/reading-case/case-nav.njk

   Secondary navigation between the reading case's sections. Pages set
   caseNavActive ('case' or 'priors'). Expects readingCase and appointment.
   With no disclosed mammograms there is nothing to switch to, so no nav. #}

{% set casePriorsCount = appointment.previousMammograms | length if appointment and appointment.previousMammograms else 0 %}

{% if casePriorsCount > 0 %}
  {{ appSecondaryNavigation({
    visuallyHiddenTitle: "Reading case sections",
    items: [
      {
        text: "Case",
        href: getReadingCaseUrl(readingCase),
        current: true if caseNavActive == 'case'
      },
      {
        text: ("Disclosed mammograms " + appCount(casePriorsCount)) | safe,
        href: getReadingCaseUrl(readingCase) + "/priors",
        current: true if caseNavActive == 'priors'
      }
    ]
  }) }}
{% endif %}
