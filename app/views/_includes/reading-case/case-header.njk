{# app/views/_includes/reading-case/case-header.njk

   Shared header for the reading case pages (case view and priors tab):
   participant name with the case's state on the right, then NHS number.
   Expects the case context locals: pageHeading, caseOutcome, caseStatus,
   caseState, appointment, isDeferred, caseAwaitingPriors, participant. #}

<div class="app-header-with-status">
  <h1 class="nhsuk-heading-l">
    <span class="nhsuk-caption-l">Image reading case</span>
    {{ pageHeading }}
  </h1>

  <div class="app-header-with-status__status-tag">
    {# Single status: outcome once concluded, otherwise the in-progress state #}
    {% if caseOutcome %}
      {{ caseOutcome | toTag({ classes: "nhsuk-u-margin-bottom-2" }) }}
    {% elseif caseStatus.provisionalOutcome %}
      {{ caseStatus.provisionalOutcome | toTag({ classes: "nhsuk-u-margin-bottom-2" }) }}
      <br><span class="nhsuk-u-secondary-text-colour nhsuk-body-s">awaiting finalisation</span>
    {% elseif caseStatus.willArbitrate and caseState == 'awaiting_finalisation' %}
      {{ "Arbitration" | toTag({ classes: "nhsuk-u-margin-bottom-2" }) }}
      <br><span class="nhsuk-u-secondary-text-colour nhsuk-body-s">awaiting finalisation</span>
    {% else %}
      {{ caseState | toTag({ vocabulary: "readingState", classes: "nhsuk-u-margin-bottom-2" }) }}
    {% endif %}

    {# Urgency matters only while the case is still open #}
    {% if caseState != 'concluded' and appointment %}
      {% set appointmentAge = appointment.timing.startTime | daysSince %}
      {% if appointmentAge >= data.config.reading.urgentThreshold %}
        <br>{{ "Urgent" | toTag }}
      {% elseif appointmentAge >= data.config.reading.priorityThreshold %}
        <br>{{ "Due soon" | toTag }}
      {% endif %}
    {% endif %}

    {% if isDeferred %}
      <br>{{ "Deferred" | toTag }}
    {% endif %}
    {% if caseAwaitingPriors %}
      <br>{{ "Awaiting priors" | toTag }}
    {% endif %}
  </div>
</div>

<p class="nhsuk-u-secondary-text-colour">
  NHS Number: {{ participant.medicalInformation.nhsNumber | formatNhsNumber }}
</p>
