{# app/views/_includes/clinic-appointment-row.njk #}
{#
  A single appointment row on the clinic page appointment list. Also rendered
  on its own by the check-in route so main.js can swap the row in place after
  checking in - keep it self-contained.

  appointment - appointment record
  participant - participant the appointment belongs to
  clinicId - id of the clinic being viewed
  filter - the current tab (e.g. "remaining"), which decides the columns shown

  Import with context - the row reads settings and the current user from data.
#}

{%- from 'tag/macro.njk' import tag -%}
{%- from 'button/macro.njk' import button -%}
{%- from '_components/copy-to-clipboard/macro.njk' import appCopyToClipboard -%}
{%- from '_components/check-in/macro.njk' import appCheckIn %}
{%- from '_includes/issues/tag.njk' import issueTag with context %}
{%- from "_includes/appointment-stopped-reason.njk" import appointmentStoppedReasonText %}

{% macro clinicAppointmentRow(appointment, participant, clinicId, filter="remaining") %}
  {% set appointmentBaseUrl = getAppointmentUrl(appointment) %}
  {% set statusTagId = "status-tag-" + appointment.id %}

  {# Which broken-out columns this tab shows (shared with the table header and
     the sort logic). Remaining and Checked in break out the check-in time;
     In progress, Complete and All break out the mammographer and screening
     order; Complete has no actions as every row is final. #}
  {% set columns = filter | getClinicTableColumns %}

  <tr class="nhsuk-table__row appointment-row" id="appointment-row-{{ appointment.id }}" data-fragment-id="{{ appointment.id }}">

    {# Appointment time, with length shown only for the longer special appointments #}
    <td class="nhsuk-table__cell app-clinic-appointments-table__time-column">
      {{ appointment.statusHistory[0].timestamp | formatTimeString }}
      {% if appointment | isSpecialAppointment %}
        <br>
        {{ tag({
        text: appointment.timing.duration + " mins",
        colour: "white",
        classes: "nhsuk-u-margin-top-1 app-nowrap"
        }) }}
      {% endif %}
    </td>

    {# Appointment details - Name and NHS number #}
    <td class="nhsuk-table__cell">
      <p class="nhsuk-u-margin-bottom-1 nhsuk-u-font-weight-bold">
        <a href="{{ appointmentBaseUrl }}">{{ participant | getShortNameReversed }}</a>
      </p>
      <p class="nhsuk-u-secondary-text-colour nhsuk-body-s app-nowrap app-code-font nhsuk-u-margin-bottom-0">
        {{ appCopyToClipboard({
          text: participant.medicalInformation.nhsNumber,
          type: "value",
          html: '<span class="nhsuk-u-font-code nhsuk-u-nowrap">' + (participant.medicalInformation.nhsNumber | formatNhsNumber) + '</span>',
          label: "NHS number"
        }) }}
      </p>
      {% if appointment | isFirstScreening(data) %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          {{ tag({
          text: "New",
          colour: "green",
          classes: "app-nowrap"
          })}}
        </p>
      {% endif %}
      {% if appointment | isLastScreening(data) %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          {{ tag({
          text: "Final",
          colour: "red",
          classes: "app-nowrap"
          })}}
        </p>
      {% endif %}
      {% if appointment | isSpecialAppointment %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          {{ tag({
          text: "Special appointment",
          colour: "yellow",
          classes: "app-nowrap"
          })}}
        </p>
        {% set specialAppointmentReasons = [] %}
        {% for supportType in appointment.specialAppointment.supportTypes %}
          {% if supportType and supportType != '_unchecked' and supportType.trim() %}
            {% set specialAppointmentReasons = specialAppointmentReasons | push(supportType) %}
          {% endif %}
        {% endfor %}
        {% if specialAppointmentReasons | length %}
          <p class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-top-0 nhsuk-u-margin-bottom-0">
            {{ specialAppointmentReasons | join(", ") }}
          </p>
        {% endif %}
      {% endif %}
      {# Asked of the episode, so an issue raised anywhere in the round shows #}
      {% if data | hasOpenIssue(appointment.episodeId) %}
        <p class="nhsuk-u-margin-top-1 nhsuk-u-margin-bottom-0">
          {{ issueTag() }}
        </p>
      {% endif %}
    </td>

    {# Date of birth #}
    <td class="nhsuk-table__cell">{{ participant.demographicInformation.dateOfBirth | formatDate }}<br>
      <span class="nhsuk-u-secondary-text-colour nhsuk-body-s">{{ participant.demographicInformation.dateOfBirth | formatRelativeDate(true)
        }}</span>
    </td>

    {# Appointment status and view appointment link #}
    <td class="nhsuk-table__cell app-clinic-appointments-table__appointment-column">
      {{ appointment.status | toTag({ id: statusTagId, vocabulary: "appointment" }) }}

      {% if appointment.status == 'attended_not_screened' and appointment | hasStoppedDetails %}
        <p class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-top-1 nhsuk-u-margin-bottom-0">
          {{ appointmentStoppedReasonText(appointment) }}
        </p>
      {% endif %}

      {% if appointment.status == 'checked_in' and not columns.checkedIn %}
        {% set checkInTime = appointment | getCheckInTime %}
        {% set waitingMinutes = appointment | getWaitingMinutes %}
        {% if checkInTime %}
          <p class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-top-0 nhsuk-u-margin-bottom-0">
            at {{ checkInTime | formatTimeString }}
            {% if waitingMinutes !== null %}
              <br>
              <span class="nhsuk-u-secondary-text-colour nhsuk-body-s js-elapsed-time" data-elapsed-since="{{ appointment | getWaitingSince }}">{{ waitingMinutes | formatWaitingTime }} ago</span>
            {% endif %}
          </p>
        {% endif %}

      {% elseif (appointment | isInProgressNotPaused) and not columns.startedAt %}
        <span class="nhsuk-u-secondary-text-colour app-nowrap nhsuk-body-s nhsuk-u-margin-bottom-0">with {{
          appointment | getAppointmentRunnerId | getUsername({ identifyCurrentUser: true }) }}</span>

      {% elseif (appointment | isFinal) and not columns.screenedBy %}
        {% if appointment.sessionDetails.startedBy %}
          <span class="nhsuk-u-secondary-text-colour app-nowrap nhsuk-body-s nhsuk-u-margin-bottom-0">by {{ appointment
            | getScreenedByName({ identifyCurrentUser: true }) }}</span>
        {% endif %}
      {% endif %}

      {% if appointment | hasAppointmentNote %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          {{ tag({
          text: "Appointment note",
          colour: "yellow",
          classes: "app-nowrap"
          })}}
        </p>
      {% endif %}
    </td>

    {# Checked in - the check-in time with the wait so far underneath. Its own
       sortable column on the Remaining and Checked in tabs; blank until the
       participant checks in. Minute granularity, with no live-ticking seconds. #}
    {% if columns.checkedIn %}
      <td class="nhsuk-table__cell app-clinic-appointments-table__checked-in-column">
        {% if appointment.status == 'checked_in' %}
          {% set checkInTime = appointment | getCheckInTime %}
          {% set waitingMinutes = appointment | getWaitingMinutes %}
          {% if checkInTime %}
            {{ checkInTime | formatTimeString }}
            {% if waitingMinutes !== null %}
              <br>
              <span class="nhsuk-u-secondary-text-colour nhsuk-body-s js-elapsed-time" data-elapsed-since="{{ appointment | getWaitingSince }}">{{ waitingMinutes | formatWaitingTime }} ago</span>
            {% endif %}
          {% endif %}
        {% endif %}
      </td>
    {% endif %}

    {# Started at - when screening started, how long ago, and who is running
       it now (whoever last started or resumed it), shown on the In progress
       tab #}
    {% if columns.startedAt %}
      {% set startedTime = appointment.sessionDetails.startedAt %}
      <td class="nhsuk-table__cell app-clinic-appointments-table__started-at-column">
        {% if startedTime %}
          {{ startedTime | formatTimeString }}
          <span class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-bottom-0 js-elapsed-time" data-elapsed-since="{{ startedTime | getElapsedSince }}">{{ startedTime | getMinutesSince | formatWaitingTime }} ago</span>
          <span class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-bottom-0">({{ appointment | getAppointmentRunnerId | getUsername }})</span>
        {% endif %}
      </td>
    {% endif %}

    {# Time completed - when the appointment ended (see getCompletedTime), then
       the screening order badge and who it was, on the Complete and All tabs.
       Attended appointments (see wasAttended) show their place in the order
       of screening and who screened them; one cancelled before it started
       shows who cancelled it. The time sits on its own line above them. #}
    {% if columns.completed %}
      {% set completedTime = appointment | getCompletedTime %}
      {% set attended = appointment | wasAttended %}
      {% set completedOrder = appointment.screeningOrder if attended %}
      {% set completedByName = "" %}
      {% if attended and appointment.sessionDetails.startedBy %}
        {% set completedByName = appointment | getAppointmentScreenedByNames({ identifyCurrentUser: true }) | join(", ") %}
      {% elseif appointment.status == 'cancelled' and appointment.cancellation.cancelledBy %}
        {% set completedByName = appointment.cancellation.cancelledBy | getUsername({ identifyCurrentUser: true }) %}
      {% endif %}
      <td class="nhsuk-table__cell app-clinic-appointments-table__completed-column">
        {% if completedTime or completedByName %}
          {# A cancellation made on an earlier day shows its date instead #}
          {% set completedOnAnotherDay = completedTime and (completedTime | formatDate("YYYY-MM-DD")) != (appointment.timing.startTime | formatDate("YYYY-MM-DD")) %}
          <span class="app-clinic-appointments-table__completed-time">{% if completedOnAnotherDay %}{{ completedTime | formatDate("D MMM") }}{% elseif completedTime %}{{ completedTime | formatTimeString }}{% endif %}</span>
          {% if completedOrder or completedByName %}
            <div class="app-clinic-appointments-table__completed-details">
              {% if completedOrder %}
                <span class="nhsapp-badge nhsapp-badge--small nhsapp-badge--muted app-nowrap nhsuk-u-margin-right-1">
                  <span aria-hidden="true">{{ completedOrder }}</span>
                  <span class="nhsuk-u-visually-hidden">{{ completedOrder | getOrdinalNumber }} in order of screening</span>
                </span>
              {% endif %}
              {% if completedByName %}
                <span class="nhsuk-u-font-size-16">{{ completedByName }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      </td>
    {% endif %}

    {# Actions - check-in or start appointment #}
    {% if columns.actions %}
    <td class="nhsuk-table__cell">
      {% if appointment.status == 'scheduled' %}
        {{ appCheckIn({
          clinicId: clinicId,
          appointment: appointment,
          participant: participant,
          confirmIdentityOnCheckIn: true if data.settings.appointment.confirmIdentityOnCheckIn == 'true' else false,
          statusTagId: statusTagId,
          currentUser: currentUser,
          currentFilter: filter
        }) }}
      {% endif %}

      {% if (currentUser | isClinician) and (appointment | isActive) %}
        {% if appointment | hasNotStarted %}
          {# Start button is rendered hidden until the appointment is checked in -
          the check-in fragment re-render drops app-display-none once it is #}
          {{ button({
            text: "Start appointment",
            href: appointmentBaseUrl + "/start?appointment[workflowStatus][appointment]=started",
            variant: "secondary",
            small: true,
            classes: "app-nowrap js-start-appointment-link" + (" app-display-none" if appointment.status == 'scheduled')
          }) }}

        {# Whoever is running it can resume it; anyone can claim a paused one #}
        {% elseif (appointment | isInProgress) and ((appointment | isRunByCurrentUser) or (appointment | isPaused)) %}
          {% set resumeText = "Resume appointment" if (appointment | isRunByCurrentUser) else "Claim appointment" %}
          {{ button({
            html: resumeText ~ ((" for " + (participant | getShortName)) | asVisuallyHiddenText),
            href: appointmentBaseUrl + "/resume",
            variant: "secondary",
            small: true
          }) }}
        {% endif %}
      {% endif %}
    </td>
    {% endif %}
  </tr>
{% endmacro %}
