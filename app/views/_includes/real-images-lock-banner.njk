{# app/views/_includes/real-images-lock-banner.njk #}
{# Says real mammogram images are wanted but not showing, because this session
   hasn't entered the access code (or none is set). Shown by layout-app.html #}

{% set realImagesLockReason = getRealImagesLockReason() %}

{% if realImagesLockReason %}
  {% set realImagesLockHtml %}
    {% if realImagesLockReason == "locked" %}
      <p class="nhsuk-notification-banner__heading">Real mammogram images are locked</p>
      <p>Diagrams are shown until you <a class="nhsuk-notification-banner__link" href="{{ '/real-images-access' | urlWithReferrer(referrerChain | appendReferrer(currentUrl)) }}">enter the access code</a>.</p>
    {% else %}
      <p class="nhsuk-notification-banner__heading">Real mammogram images are not available</p>
      <p>No access code has been set for this prototype, so diagrams are shown.</p>
    {% endif %}
  {% endset %}

  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">
      {{ notificationBanner({
        html: realImagesLockHtml
      }) }}
    </div>
  </div>
{% endif %}
