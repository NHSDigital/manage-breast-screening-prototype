{# app/views/_includes/close-clinic-appointment-row.njk #}
{#
  A single appointment row on the close clinic page. Also rendered on its own
  by the appointment-row fragment route so close-clinic.js can swap a row in
  place after a status change - keep it self-contained.

  appointment - appointment record
  participant - participant the appointment belongs to
  clinicId - id of the clinic being closed

  Import with context so openInModal can read the modal forms setting.
#}

{%- from '_components/link/macro.njk' import appLink %}

{% macro closeClinicAppointmentRow(appointment, participant, clinicId) %}
  {% set reasonUrl = "/clinics/" + clinicId + "/close/reason/" + appointment.id %}
  {% set setStatusUrl = "/clinics/" + clinicId + "/close/set-status/" + appointment.id + "/" %}
  <tr data-fragment-id="{{ appointment.id }}">
    <td class="nhsuk-table__cell">{{ appointment.statusHistory[0].timestamp | formatTimeString }}</td>
    <td class="nhsuk-table__cell">
      <p class="nhsuk-u-margin-bottom-1 nhsuk-u-font-weight-bold">{{ participant | getFullNameReversed }}</p>
      <p class="nhsuk-u-secondary-text-colour nhsuk-u-margin-bottom-1">NHS: {{ participant.medicalInformation.nhsNumber | formatNhsNumber | noWrap }}</p>
      <p class="nhsuk-u-margin-bottom-0 app-nowrap"><a href="/clinics/{{ clinicId }}/appointments/{{ appointment.id }}">View appointment</a></p>
    </td>
    <td class="nhsuk-table__cell">
      {{ appointment.status | toTag({ vocabulary: "appointment" }) }}
      {% if appointment | isInProgress and appointment.sessionDetails.startedBy %}
        <span class="nhsuk-u-secondary-text-colour nhsuk-body-s nhsuk-u-margin-bottom-0">with {{ appointment.sessionDetails.startedBy | getUsername({
          format: "short",
          identifyCurrentUser: true
        }) }}</span>
      {% endif %}
      {% if appointment.status == "rescheduled" and appointment | hasStoppedDetails %}
        {{ "attended_not_screened" | toTag({ vocabulary: "appointment" }) }}
      {% endif %}
      {% if appointment | hasStoppedDetails %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">{{ appointment.appointmentStopped.stoppedReason | join(", ") }}</p>
      {% endif %}
      {% if appointment.status == "checked_in" %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          <a href="{{ setStatusUrl }}scheduled" data-fragment-action>Change to scheduled</a>
        </p>
      {% elseif appointment.status == "scheduled" %}
        <p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0">
          <a href="{{ setStatusUrl }}checked_in" data-fragment-action>Change to checked in</a>
        </p>
      {% endif %}
    </td>
    <td class="nhsuk-table__cell">
      {# Undoing attended not screened or rescheduled also clears the recorded details #}
      {% if appointment | isInProgress %}
        <a href="/clinics/{{ clinicId }}/appointments/{{ appointment.id }}">Go to appointment</a>
      {% elseif appointment.status == "checked_in" %}
        {{ appLink({
          text: "Mark as attended not screened",
          href: reasonUrl
        } | openInModal) }}
      {% elseif appointment.status == "scheduled" %}
        <a href="{{ setStatusUrl }}did_not_attend" data-fragment-action>Mark as did not attend</a>
      {% elseif appointment.status == "did_not_attend" %}
        <a href="{{ setStatusUrl }}scheduled" data-fragment-action>Undo status</a>
      {% elseif appointment.status == "attended_not_screened" or (appointment.status == "rescheduled" and appointment | hasStoppedDetails) %}
        <a href="{{ setStatusUrl }}checked_in" data-fragment-action>Undo status</a>
        <br>{{ appLink({
          text: "Change details",
          href: reasonUrl
        } | openInModal) }}
      {% endif %}
    </td>
  </tr>
{% endmacro %}
