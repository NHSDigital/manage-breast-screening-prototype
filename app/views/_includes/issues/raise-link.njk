{# app/views/_includes/issues/raise-link.njk

   The link to raise an issue from any page. It raises the issue on the most
   specific record the page has loaded (readingCase, then appointment, then
   episode, then participant) and returns the user here afterwards. Opens in a modal where modal
   forms are on.

   Import with context - it reads those records, currentUrl and referrerChain
   from the page.

   Arguments:
   - raisedFrom - the journey, from ISSUE_RAISED_FROM in app/lib/utils/issues.js
   - options.text - link text, where the page needs something more specific
     than the default for the journey ("Raise another issue" once one is open)
   - options.type - issue type to preselect, from ISSUE_TYPES
   - options.classes - extra classes for the paragraph #}

{% from '_components/link/macro.njk' import appLink %}

{% macro raiseIssueLink(raisedFrom, options = {}) %}
  {% set raiseUrl = getRaiseIssueUrl({
    readingCase: readingCase,
    appointment: appointment,
    episode: episode,
    participant: participant
  }, raisedFrom, options.type) %}

  {# For now, using the same text for all raisedFrom values #}
  {% set linkTextByRaisedFrom = {
    reading_case: "Raise an issue",
    appointment: "Raise an issue",
    episode: "Raise an issue",
    participant: "Raise an issue"
  } %}

  {% if raiseUrl %}
    {% set defaultText = "Raise another issue" if (data | hasOpenIssue(episode or participant)) else (linkTextByRaisedFrom[raisedFrom] or "Raise an issue") %}
    <p class="{{ options.classes }}">
      {{ appLink({
        text: options.text or defaultText,
        href: raiseUrl | urlWithReferrer(referrerChain | appendReferrer(currentUrl)),
        classes: "nhsuk-link--no-visited-state"
      } | openInModal) }}
    </p>
  {% endif %}
{% endmacro %}
