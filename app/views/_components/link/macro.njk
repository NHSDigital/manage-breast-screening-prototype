{# app/views/_components/link/macro.njk #}
{#
  Purpose: A plain link as a macro.
  Use when: progressively enhancing a link to open in a modal, by passing its params through the openInModal filter. For example {{ appLink({ text: "Cancel appointment", href: cancelUrl } | openInModal) }}
  NHS equivalent: `link`, which has more options, such as `visuallyHiddenText` and `openInNewTab`. Use that when they are needed.

  Params:
    text        {string}  Required if html not set. Link text.
    html        {string}  Required if text not set. Link HTML content.
    href        {string}  Required. The URL.
    classes     {string}  Optional. Additional CSS classes.
    id          {string}  Optional. ID attribute.
    attributes  {object}  Optional. Additional HTML attributes (e.g. data attributes
                          added by openInModal filter).
#}

{% macro appLink(params) %}
  {%- include "./template.njk" -%}
{% endmacro %}
