{# app/views/_components/environment/macro.njk #}
{#
  Purpose: A full-width banner naming the environment the prototype is running in.
  Use when: rarely. The layouts already render it when the environment banner setting is on.
  NHS equivalent: `environmentBanner`.

  Params:
    name       — shown as a tag
    colour     — NHS tag colour (default: "blue")
    text, html — the banner message
#}
{%- macro appEnvironment(params) -%}
  {%- include "./template.njk" -%}
{% endmacro %}